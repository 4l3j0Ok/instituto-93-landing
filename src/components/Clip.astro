---
interface Props {
  src: string;
  poster: string;
  width: number;
  height: number;
  label: string;
  hasAudio?: boolean;
  class?: string;
  caption?: string;
}

const { src, poster, width, height, label, hasAudio = false, class: className, caption } = Astro.props;
---

<figure class:list={['media', 'clip', className]} data-clip data-protected>
  <div class="clip__frame">
    <video
      muted
      loop
      playsinline
      preload="none"
      poster={poster}
      width={width}
      height={height}
      aria-label={label}
      disablepictureinpicture
      disableremoteplayback
      controlslist="nodownload noremoteplayback nofullscreen"
      tabindex="-1"
    >
      <source src={src} type="video/mp4" />
    </video>
    <div class="clip__bar">
      <button class="clip__btn" type="button" data-action="toggle" aria-label="Pausar video" aria-pressed="false">
        <svg class="i-pause" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M5 3v12M13 3v12" stroke="currentColor" stroke-width="2.4" /></svg>
        <svg class="i-play" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M5 3l10 6-10 6z" fill="currentColor" /></svg>
      </button>
      {hasAudio && (
        <button class="clip__btn" type="button" data-action="sound" aria-label="Activar sonido" aria-pressed="false">
          <svg class="i-muted" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M2 7h3l4-3.5v11L5 11H2z" fill="currentColor" /><path d="M12 6.5l4 5m0-5l-4 5" stroke="currentColor" stroke-width="1.8" /></svg>
          <svg class="i-sound" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M2 7h3l4-3.5v11L5 11H2z" fill="currentColor" /><path d="M12 6c1.6 1.6 1.6 4.4 0 6m2.3-8.3c3 3 3 7.6 0 10.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
        </button>
      )}
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
