---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<button class="slide__expand" type="button" aria-label={label}>
  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
    <path d="M10.5 2.5h5v5m0-5L10 8m-2.5 7.5h-5v-5m0 5L8 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" />
  </svg>
</button>
